							"raw": "{\n  \"rule_id\": \"detect-sqli-002\",\n  \"name\": \"SQL Injection Detection - Nginx\",\n  \"description\": \"Detecta patrones de SQL Injection en request_uri de nginx\",\n  \"index\": [\"filebeat-nginx-access-*\"],\n  \"type\": \"query\",\n  \"language\": \"kuery\",\n  \"query\": \"request_uri: (*OR* or *UNION* or *SELECT* or *INSERT* or *DROP* or *--* or *%27* or *1=1*)\",\n  \"severity\": \"high\",\n  \"risk_score\": 80,\n  \"interval\": \"1m\",\n  \"from\": \"now-2m\",\n  \"enabled\": true,\n  \"tags\": [\"SQL Injection\", \"Web Attack\", \"OWASP\"]\n}",
